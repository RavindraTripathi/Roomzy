# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps JavaScript API key for interactive room locality maps.
VITE_GOOGLE_MAPS_API_KEY=""

# CASHFREE_APP_ID & CASHFREE_SECRET_KEY: Server-side Cashfree Payment Gateway credentials for Indian INR payments.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox"
CASHFREE_WEBHOOK_SECRET=""

# KYC_PROVIDER_API_KEY: Optional server-side third-party KYC provider API key (DigiLocker / IDfy / Cashfree Verification).
KYC_PROVIDER_API_KEY=""
